# Fitbit OAuth — Register at https://dev.fitbit.com/apps/new
# App type: Personal | Callback URL: http://localhost:9876/callback
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Food Scanner API — Get key from food-scanner app settings
FOOD_SCANNER_URL=http://localhost:3000
FOOD_SCANNER_API_KEY=

# Report settings
REPORT_OUTPUT_DIR=./output
